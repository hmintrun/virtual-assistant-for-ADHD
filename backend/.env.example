# Environment Variables Example for ProPlan VA Backend

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="ProPlan VA"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-jwt-key

# Database URL (SQLite for Dev, PostgreSQL for Prod)
DATABASE_URL=sqlite+aiosqlite:///./proplan.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proplan

# AI / LLM Engine (Tier 1: Gemini 3.8 Flash + Warm Backup 3.5 Flash-Lite)
# Option 1: Drop Service Account JSON at backend/credentials.json (Vertex / Agent Platform Postpay - auto-detected)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# Option 2: Or provide Google AI Studio API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Voice STT & Tier 2 LLM Fallback (Groq Cloud: qwen/qwen3.8-27b & whisper-large-v3-turbo)
GROQ_API_KEY=your-groq-api-key-here
