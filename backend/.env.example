# Environment Variables Example for ProPlan VA Backend

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="ProPlan VA"
API_V1_STR=/api/v1
# JSON list of exact Flutter Web origins. Omit for local :8080 defaults in dev/test.
# Staging/production start with an empty allowlist unless explicitly configured.
# CORS_ALLOWED_ORIGINS=["http://localhost:8080"]
# Local Calendar credential fallback. Staging/production require a separate random value (>= 32 bytes).
SECRET_KEY=change-this-to-a-super-secret-jwt-key

# App authentication: dev_user only in development/testing. Staging/production require google.
AUTH_MODE=dev_user
# Set an independent cryptographically random secret (at least 32 bytes), never SECRET_KEY.
JWT_SECRET_KEY=
# Bearer token required on /metrics and /api/v1/metrics when ENVIRONMENT=staging|production.
# METRICS_AUTH_TOKEN=your-random-metrics-bearer-token
JWT_ISSUER=proplan-va
JWT_AUDIENCE=proplan-va-api
ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=0
# JSON list of OAuth client IDs accepted as Google ID token audiences.
GOOGLE_SIGN_IN_AUDIENCES=[]
GOOGLE_AUTH_TIMEOUT_SECONDS=5
# Thời gian tối thiểu để xem/duyệt phương án trước phiên đầu (giây, >= 120).
PLANNING_REVIEW_LEAD_SECONDS=300

# Database URL (SQLite for Dev, PostgreSQL for Prod)
DATABASE_URL=sqlite+aiosqlite:///./proplan.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proplan

# AI / LLM Engine (Gemini 3.5 Flash-Lite + Groq Qwen Fallback)
# Khóa xác thực chính qua Google AI Studio API Key (ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
# GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_SECONDS=4.5
# AI_PRIMARY_PRIORITY_SECONDS=3.0
# AI_WARM_BACKUP_DELAY_SECONDS=1.5
# AI_GROQ_HEDGE_DELAY_SECONDS=2.2

# UF1: 6s cơ sở, cộng 2s/4s theo ngữ cảnh, tối đa 15s.
# GEMINI_UF1_MODEL=gemini-3.5-flash-lite
# GEMINI_UF1_BACKUP_MODEL=
# UF1_AUDIO_NATIVE_ENABLED=false
# AI_UF1_TIMEOUT_SECONDS=6.0
# AI_UF1_ADAPTIVE_TIMEOUT_ENABLED=true
# AI_UF1_PRIMARY_PRIORITY_SECONDS=4.5
# AI_UF1_GROQ_FAST_FAIL_SECONDS=3.5   # Đặt 0 để tắt speculative hedge Tier 2 (chỉ fallback khi Gemini lỗi)

# UF2 Rolling Horizon, Decompose (Khung B) & Batch Session Enrichment (Khung C)
# DEFAULT_PLANNING_HORIZON_DAYS=14
# MAX_PLANNING_HORIZON_DAYS=21
# AI_UF2_TIMEOUT_SECONDS=9.0
# AI_UF2_PRIMARY_PRIORITY_SECONDS=4.5
# AI_UF2_WARM_BACKUP_DELAY_SECONDS=2.0
# AI_UF2_GROQ_HEDGE_DELAY_SECONDS=5.0
# AI_UF2_ENRICH_TIMEOUT_SECONDS=3.0
# AI_UF2_ENRICH_PRIMARY_PRIORITY_SECONDS=1.8
# AI_UF2_ENRICH_WARM_BACKUP_DELAY_SECONDS=1.0
# AI_UF2_ENRICH_GROQ_HEDGE_DELAY_SECONDS=1.6

# Tier 2 LLM Fallback (Groq Cloud: qwen/qwen3.8-27b & secondary openai/gpt-oss-20b)
GROQ_API_KEY=your-groq-api-key-here
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# GROQ_SECONDARY_FALLBACK_MODEL=openai/gpt-oss-20b

# Voice STT (V01 & A21): Kiến trúc 3 tầng auto (Gemini 3.5 Transcribe -> ElevenLabs Scribe v2 -> Deepgram Nova-3, đã bỏ Groq STT)
# Khi chỉ có một số provider key trong .env, mode auto tự động rút gọn chuỗi theo key khả dụng.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# VOICE_STT_PROVIDER=auto              # auto | gemini | elevenlabs | deepgram | fake (auto: gemini->elevenlabs->deepgram theo key)
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_BASE_URL=https://api.elevenlabs.io/v1/speech-to-text
# ELEVENLABS_STT_TAG_AUDIO_EVENTS=false # false: không chèn tag hiệu ứng âm thanh làm nhiễu ITN
# ELEVENLABS_STT_DIARIZE=false
# ELEVENLABS_STT_TIMEOUT_SECONDS=5.0
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_PUNCTUATE=true
# DEEPGRAM_STT_SMART_FORMAT=false      # false: giữ verbatim cho tầng T2 ITN/ReALM chuẩn hóa giờ nói & cụm đính chính
# DEEPGRAM_STT_BASE_URL=https://api.deepgram.com/v1/listen
# DEEPGRAM_STT_USE_KEYTERMS=false      # true: gửi thêm contextual_hints qua query param keyterm
# DEEPGRAM_STT_TIMEOUT_SECONDS=5.0
# GEMINI_STT_MODEL=gemini-3.5-transcribe   # hoặc gemini-3.5-flash-lite (transport inline + prompt)
# GEMINI_STT_TRANSPORT=auto            # auto | transcribe_inline | inline | transcribe_api (legacy, ~10s)
# GEMINI_STT_MODE=verbatim             # verbatim (nguyên văn, để LLM UF1 tự hiểu câu tự sửa) | smart (bỏ từ đệm, tự sửa)
# VOICE_STT_LANGUAGE=vi-VN
# VOICE_STT_UF5_PREFER_ELEVENLABS=true # true: ưu tiên ElevenLabs (~1.0s) cho uf5_checkin (câu ngắn) khi có key
# VOICE_STT_PRIMARY_TIMEOUT_SECONDS=7.0
# VOICE_STT_TIMEOUT_SECONDS=12.0
# VOICE_MAX_AUDIO_BYTES=10485760
# VOICE_MULTIPART_OVERHEAD_BYTES=1048576

# Voice TTS (W3-09): Edge-TTS tiếng Việt (fallback về flutter_tts trên thiết bị nếu lỗi/offline)
# VOICE_TTS_PROVIDER=edge_tts      # edge_tts | fake
# VOICE_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural
# VOICE_TTS_TIMEOUT_SECONDS=10
# VOICE_TTS_MAX_CHARS=600
# VOICE_TTS_CACHE_SIZE=64
# VOICE_TTS_HEDGE_DELAY_SECONDS=1.2   # Edge chậm hơn mốc này → gửi thêm 1 request song song (0 = tắt)
# VOICE_TTS_PREWARM=true              # Render sẵn 7 câu hỏi Check-in UF5 khi server khởi động

# Google Calendar Integration (A22.1 - O23 CalendarConnection & Event Ingestion)
# CALENDAR_PROVIDER_MODE=fake      # fake (offline mock cho dev/test) | real (gọi Google Calendar API thật)
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here
# GOOGLE_OAUTH_REDIRECT_URI=https://virtual-assistant-for-adhd.onrender.com/api/v1/calendar/oauth/callback
# Staging/production require a stable Fernet key generated separately from SECRET_KEY and JWT_SECRET_KEY.
# CALENDAR_CREDENTIAL_SECRET_KEY=your-32-byte-base64-fernet-key-here
