# Environment Variables Example for ProPlan VA Backend

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="ProPlan VA"
API_V1_STR=/api/v1
# Existing Calendar credential fallback key: do not rotate as part of Auth setup.
SECRET_KEY=change-this-to-a-super-secret-jwt-key

# App authentication: dev_user only in development/testing. Staging/production require google.
AUTH_MODE=dev_user
# Set an independent cryptographically random secret (at least 32 bytes), never SECRET_KEY.
JWT_SECRET_KEY=
JWT_ISSUER=proplan-va
JWT_AUDIENCE=proplan-va-api
ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=0
# JSON list of OAuth client IDs accepted as Google ID token audiences.
GOOGLE_SIGN_IN_AUDIENCES=[]
GOOGLE_AUTH_TIMEOUT_SECONDS=5
# Thời gian tối thiểu để xem/duyệt phương án trước phiên đầu (giây, >= 120).
PLANNING_REVIEW_LEAD_SECONDS=300

# Database URL (SQLite for Dev, PostgreSQL for Prod)
DATABASE_URL=sqlite+aiosqlite:///./proplan.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proplan

# AI / LLM Engine (Gemini 3.5 Flash-Lite + Groq Qwen Fallback)
# Khóa xác thực chính qua Google AI Studio API Key (ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# UF1: 6s cơ sở, cộng 2s/4s theo ngữ cảnh, tối đa 15s.
# GEMINI_UF1_MODEL=gemini-3.5-flash-lite
# AI_UF1_TIMEOUT_SECONDS=6.0
# AI_UF1_ADAPTIVE_TIMEOUT_ENABLED=true
# AI_UF1_PRIMARY_PRIORITY_SECONDS=4.5
# AI_UF1_GROQ_FAST_FAIL_SECONDS=3.5

# Tier 2 LLM Fallback (Groq Cloud: qwen/qwen3.8-27b)
GROQ_API_KEY=your-groq-api-key-here

# Voice STT (V01 & A21): Gemini 3.5 Transcribe hoặc Groq Whisper (whisper-large-v3-turbo)
# VOICE_STT_PROVIDER=auto          # auto | gemini | groq | fake (auto: ưu tiên Groq Whisper, fallback sang Gemini)
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_STT_MODE=smart            # smart (bỏ từ đệm) | verbatim (nguyên văn)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# VOICE_STT_LANGUAGE=vi-VN
# VOICE_STT_TIMEOUT_SECONDS=20

# Voice TTS (W3-09): Edge-TTS tiếng Việt (fallback về flutter_tts trên thiết bị nếu lỗi/offline)
# VOICE_TTS_PROVIDER=edge_tts      # edge_tts | fake
# VOICE_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural
# VOICE_TTS_TIMEOUT_SECONDS=10
# VOICE_TTS_MAX_CHARS=600
# VOICE_TTS_CACHE_SIZE=64

# Google Calendar Integration (A22.1 - O23 CalendarConnection & Event Ingestion)
# CALENDAR_PROVIDER_MODE=fake      # fake (offline mock cho dev/test) | real (gọi Google Calendar API thật)
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
# CALENDAR_CREDENTIAL_SECRET_KEY=your-32-byte-base64-fernet-key-here
